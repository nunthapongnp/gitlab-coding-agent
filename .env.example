# GitLab.com default. For self-managed GitLab, set your instance URL.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-your-token-here
# For personal access tokens, oauth2 is commonly accepted; for project/group tokens use the token bot username if required.
GITLAB_GIT_USERNAME=agent-bot

# Ollama local OpenAI-compatible API
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=ollama/llama3.2:3b
OLLAMA_API_KEY=ollama

# OpenHands run limits
OPENHANDS_MAX_ITERATIONS=35
OPENHANDS_TIMEOUT_SECONDS=1800

# Validation gate. Empty build/test commands mean auto-detect from repo files.
# SETUP_COMMAND is optional, e.g. npm ci, pnpm install --frozen-lockfile, uv sync --locked
SETUP_COMMAND=
BUILD_COMMAND=
TEST_COMMAND=
MAX_FIX_ATTEMPTS=3
CHECK_TIMEOUT_SECONDS=1200

# Git identity used only for the POC commit; not written to global git config.
GIT_AUTHOR_NAME=agent-bot
GIT_AUTHOR_EMAIL=ai@agent.bot

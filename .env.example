GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_GIT_USERNAME=agent-bot

# Required: complete LiteLLM Proxy API root and configured alias; no defaults.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# SDK limits per role invocation/request, separate from workflow budgets.
OPENHANDS_MAX_ITERATIONS=35
OPENHANDS_TIMEOUT_SECONDS=1800

# Shared repairs after initial coding; total implement limit (one hour).
MAX_FIX_ATTEMPTS=3
EXECUTION_MAX_RUNTIME_SECONDS=3600
CHECK_TIMEOUT_SECONDS=1200

# Optional repository command hints; later slices implement full discovery.
SETUP_COMMAND=
BUILD_COMMAND=
TEST_COMMAND=

GIT_AUTHOR_NAME=agent-bot
GIT_AUTHOR_EMAIL=ai@agent.bot
